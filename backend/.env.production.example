# Environment
NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://your-domain.com
FRONTEND_URL=https://your-domain.com

# Database (PostgreSQL Production)
DATABASE_URL=postgresql://user:password@production-db-host:5432/flowboard_prod?sslmode=require

# JWT Authentication
JWT_SECRET=replace-with-secure-random-32-char-string-in-production

# Mailer / Password Reset (SMTP Production)
MAILER_MODE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=no-reply@your-domain.com

# OAuth Authentication (Google & GitHub Production Callbacks)
GOOGLE_CLIENT_ID=your_production_google_client_id
GOOGLE_CLIENT_SECRET=your_production_google_client_secret
GOOGLE_CALLBACK_URL=https://your-domain.com/api/auth/oauth/google/callback

GITHUB_CLIENT_ID=your_production_github_client_id
GITHUB_CLIENT_SECRET=your_production_github_client_secret
GITHUB_CALLBACK_URL=https://your-domain.com/api/auth/oauth/github/callback
