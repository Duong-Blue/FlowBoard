model Organization {
  id            String               @id @default(uuid())
  name          String
  slug          String               @unique
  description   String?
  logoUrl       String?
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  members       OrganizationMember[]
  invitations   Invitation[]
  projects      Project[]
  notifications Notification[]
}
