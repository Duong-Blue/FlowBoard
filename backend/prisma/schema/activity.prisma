enum ActivityScope {
  ISSUE
  PROJECT
  ORGANIZATION
}

enum ActivityType {
  ISSUE_CREATED
  TITLE_CHANGED
  DESCRIPTION_CHANGED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNEE_CHANGED
  COMMENT_CREATED
  COMMENT_UPDATED
  COMMENT_DELETED
  SUBTASK_CREATED
  SUBTASK_DELETED
  RELATION_CREATED
  RELATION_DELETED
  ATTACHMENT_UPLOADED
  ATTACHMENT_DELETED
  START_DATE_SET
  START_DATE_CHANGED
  START_DATE_REMOVED
  DUE_DATE_SET
  DUE_DATE_CHANGED
  DUE_DATE_REMOVED
  ISSUE_COMPLETED
  ISSUE_REOPENED
  TYPE_CHANGED
  SUBTASK_PARENT_CHANGED
  PROJECT_CREATED
  PROJECT_MEMBER_ADDED
  PROJECT_MEMBER_REMOVED
  ORG_MEMBER_ADDED
  ORG_MEMBER_REMOVED
  MILESTONE_CREATED
  MILESTONE_UPDATED
  MILESTONE_DELETED
}

model Activity {
  id        String       @id @default(uuid())
  issueId   String?
  actorId   String?
  type      ActivityType
  entityType ActivityScope @default(ISSUE)
  projectId String?
  organizationId String?
  metadata  Json         @default("{}")
  createdAt DateTime     @default(now())

  issue Issue? @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actor User? @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  project Project? @relation("ProjectActivities", fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization? @relation("OrganizationActivities", fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt, id])
  @@index([organizationId, createdAt, id])
  @@index([actorId])
  @@map("activities")
}
