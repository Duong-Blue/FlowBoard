enum IssueStatus {
  TODO
  IN_PROGRESS
  IN_PREVIEW
  DONE
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum IssueType {
  TASK
  BUG
  FEATURE
  IMPROVEMENT
}

model Issue {
  id          String        @id @default(uuid())
  projectId   String
  key         String?
  title       String
  description String?
  order       String
  status      IssueStatus   @default(TODO)
  type        IssueType     @default(TASK)
  priority    IssuePriority @default(MEDIUM)
  reporterId  String
  assigneeId  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  startDate   DateTime?     @map("start_date") @db.Timestamptz
  dueDate     DateTime?     @map("due_date") @db.Timestamptz
  completedAt DateTime?     @map("completed_at") @db.Timestamptz

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reporter User    @relation("IssueReporter", fields: [reporterId], references: [id])
  assignee User?   @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  comments      Comment[]
  activities    IssueActivity[]
  notifications Notification[]

  parentId          String?         @map("parent_id")
  parent            Issue?          @relation("IssueParentSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks          Issue[]         @relation("IssueParentSubtasks")
  relationsAsSource IssueRelation[] @relation("RelationSource")
  relationsAsTarget IssueRelation[] @relation("RelationTarget")
  attachments       Attachment[]

  @@index([projectId, status])
  @@index([projectId, assigneeId])
  @@index([projectId, createdAt])
  @@index([projectId, dueDate])
  @@index([parentId])
}
