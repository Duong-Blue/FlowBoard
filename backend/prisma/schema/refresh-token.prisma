model RefreshToken {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash       String    @unique
  familyId        String    @default(uuid())
  replacedByToken String?
  expiresAt       DateTime
  revokedAt       DateTime?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime  @default(now())
}
